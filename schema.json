{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "urn:markdown-annotation:document-comments:2.0.0",
    "title": "Markdown document comments",
    "description": "Append-only review requests and agent responses for one Markdown document.",
    "$comment": "The Markdown Annotation Extension storage, discovery, and embedded-block rules are defined in SPECIFICATION.md.",
    "type": "object",
    "required": [
        "schemaVersion",
        "createdAt",
        "updatedAt",
        "entries"
    ],
    "properties": {
        "$schema": {
            "type": "string"
        },
        "schemaVersion": {
            "type": "string",
            "const": "2.0.0"
        },
        "createdAt": {
            "type": "string",
            "format": "date-time"
        },
        "updatedAt": {
            "type": "string",
            "format": "date-time"
        },
        "entries": {
            "type": "array",
            "items": {
                "$ref": "#/$defs/entry"
            }
        },
        "editor": {
            "$ref": "#/$defs/editor"
        }
    },
    "$defs": {
        "selection": {
            "type": "object",
            "required": [
                "text"
            ],
            "properties": {
                "text": {
                    "type": "string",
                    "minLength": 0
                },
                "prefix": {
                    "type": "string"
                },
                "suffix": {
                    "type": "string"
                },
                "placement": {
                    "type": "string",
                    "enum": [
                        "before",
                        "after"
                    ]
                }
            },
            "additionalProperties": true
        },
        "section": {
            "type": "object",
            "required": [
                "heading"
            ],
            "properties": {
                "heading": {
                    "type": "string"
                },
                "text": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "event": {
            "type": "object",
            "required": [
                "eventId",
                "type",
                "timestamp"
            ],
            "properties": {
                "eventId": {
                    "type": "string",
                    "format": "uuid"
                },
                "type": {
                    "enum": [
                        "created",
                        "submitted",
                        "addressed",
                        "unmatched",
                        "deleted"
                    ]
                },
                "timestamp": {
                    "type": "string",
                    "format": "date-time"
                },
                "response": {
                    "type": "string"
                }
            },
            "additionalProperties": true
        },
        "entry": {
            "type": "object",
            "required": [
                "id",
                "kind",
                "operation",
                "createdAt",
                "section",
                "selection",
                "events"
            ],
            "properties": {
                "id": {
                    "type": "string",
                    "format": "uuid"
                },
                "kind": {
                    "enum": [
                        "comment",
                        "text-edit"
                    ]
                },
                "operation": {
                    "enum": [
                        "comment",
                        "delete",
                        "add",
                        "reword"
                    ]
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time"
                },
                "section": {
                    "$ref": "#/$defs/section"
                },
                "selection": {
                    "$ref": "#/$defs/selection"
                },
                "comment": {
                    "type": "string",
                    "minLength": 1
                },
                "value": {
                    "type": "string"
                },
                "events": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "prefixItems": [
                        {
                            "allOf": [
                                {
                                    "$ref": "#/$defs/event"
                                },
                                {
                                    "properties": {
                                        "type": {
                                            "const": "created"
                                        }
                                    }
                                }
                            ]
                        }
                    ],
                    "contains": {
                        "properties": {
                            "type": {
                                "const": "created"
                            }
                        },
                        "required": [
                            "type"
                        ]
                    },
                    "minContains": 1,
                    "maxContains": 1,
                    "items": {
                        "$ref": "#/$defs/event"
                    }
                }
            },
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "operation": {
                                "const": "comment"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "kind": {
                                "const": "comment"
                            }
                        },
                        "required": [
                            "comment"
                        ],
                        "not": {
                            "required": [
                                "value"
                            ]
                        }
                    },
                    "else": {
                        "properties": {
                            "kind": {
                                "const": "text-edit"
                            }
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "operation": {
                                "enum": [
                                    "add",
                                    "reword"
                                ]
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "value"
                        ]
                    },
                    "else": {
                        "not": {
                            "required": [
                                "value"
                            ]
                        }
                    }
                },
                {
                    "if": {
                        "properties": {
                            "operation": {
                                "const": "add"
                            }
                        }
                    },
                    "then": {
                        "properties": {
                            "selection": {
                                "allOf": [
                                    {
                                        "if": {
                                            "properties": {
                                                "text": {
                                                    "const": ""
                                                }
                                            },
                                            "required": [
                                                "text"
                                            ]
                                        },
                                        "then": {
                                            "required": [
                                                "prefix",
                                                "suffix"
                                            ],
                                            "anyOf": [
                                                {
                                                    "properties": {
                                                        "prefix": {
                                                            "const": ""
                                                        }
                                                    }
                                                },
                                                {
                                                    "properties": {
                                                        "suffix": {
                                                            "const": ""
                                                        }
                                                    }
                                                }
                                            ]
                                        }
                                    }
                                ]
                            }
                        }
                    },
                    "else": {
                        "properties": {
                            "selection": {
                                "properties": {
                                    "text": {
                                        "minLength": 1
                                    }
                                },
                                "not": {
                                    "required": [
                                        "placement"
                                    ]
                                }
                            }
                        }
                    }
                }
            ],
            "additionalProperties": true
        },
        "editor": {
            "type": "object",
            "description": "Application that last wrote this annotation payload. Informational, not authenticated authorship.",
            "required": [
                "name"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "version": {
                    "type": "string",
                    "minLength": 1
                },
                "url": {
                    "type": "string",
                    "format": "uri"
                }
            },
            "additionalProperties": true
        }
    },
    "additionalProperties": true
}
